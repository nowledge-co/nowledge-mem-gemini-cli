{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "load-working-memory",
            "type": "command",
            "command": "node \"${extensionPath}${/}hooks${/}session-start.mjs\"",
            "description": "Load Working Memory into Gemini at session start.",
            "timeout": 10000
          }
        ]
      },
      {
        "hooks": [
          {
            "name": "bridge-sessionstart",
            "type": "command",
            "command": "node \"${extensionPath}${/}hooks${/}bridge-notice.mjs\"",
            "description": "Use actual session correlation for local Bridge notices.",
            "timeout": 2000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "name": "auto-save-thread",
            "type": "command",
            "command": "node \"${extensionPath}${/}hooks${/}session-end.mjs\"",
            "description": "Best-effort Gemini session import on shutdown.",
            "timeout": 20000
          }
        ]
      },
      {
        "hooks": [
          {
            "name": "bridge-sessionend",
            "type": "command",
            "command": "node \"${extensionPath}${/}hooks${/}bridge-notice.mjs\"",
            "description": "Use actual session correlation for local Bridge notices.",
            "timeout": 2000
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "hooks": [
          {
            "name": "save-thread-before-compression",
            "type": "command",
            "command": "node \"${extensionPath}${/}hooks${/}session-end.mjs\"",
            "description": "Best-effort Gemini session import before context compression.",
            "timeout": 20000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "bridge-beforeagent",
            "type": "command",
            "command": "node \"${extensionPath}${/}hooks${/}bridge-notice.mjs\"",
            "description": "Use actual session correlation for local Bridge notices.",
            "timeout": 2000
          }
        ]
      }
    ]
  }
}
